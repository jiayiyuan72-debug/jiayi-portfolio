# 环境变量配置
# 复制此文件为 .env.local 并填写真实值

# Supabase 配置（在 supabase.com 项目设置中获取）
NEXT_PUBLIC_SUPABASE_URL=https://你的项目ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=你的anon公钥
SUPABASE_SERVICE_ROLE_KEY=你的service_role密钥

# 管理员密码（使用 scripts/hash-password.ts 生成）
# 先运行：npx tsx scripts/hash-password.ts
# 然后把输出的哈希值填在这里
ADMIN_PASSWORD_HASH=$2b$10$你的bcrypt哈希值

# Session 密钥（至少 32 个字符的随机字符串）
SESSION_SECRET=请替换为一个至少32字符的随机字符串
